/* hold 없이는 성공함
behaviors {
        // 1. Alt 체크 Mod-Morph: Alt가 눌려있으면 [, 안 눌려있으면 기본 ,
        comma_alt_morph: comma_alt_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LBKT>; // 기본: , / Alt 적용 시: [
            mods = <(MOD_LALT|MOD_RALT)>;        // Left/Right Alt 감지
        };

        // 2. Ctrl 체크 Mod-Morph: Ctrl이 눌려있으면 (, 안 눌려있으면 comma_alt_morph 실행
